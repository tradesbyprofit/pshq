# Copy this file to ".env" on YOUR machine and fill in your values.
# Then:  cp .env.example .env  &&  nano .env
# run.sh will load it automatically. NEVER commit a real .env.

# OANDA Practice/Demo ONLY (api-fxpractice.oanda.com). Never a live token.
OANDA_API_TOKEN=your-practice-token-here
OANDA_ACCOUNT_ID=101-001-xxxxxxxx-xxx

# Telegram (optional — for A+ setup alerts)
TG_BOT_TOKEN=your-telegram-bot-token
TG_CHAT_ID=your-chat-id
